<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:paddingTop="38dp"
        android:paddingBottom="38dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dim_label"
            android:textColor="#FFFFFFFF"
            android:fontFamily="@string/font_medium"
            android:textSize="34sp" />

        <LinearLayout
            android:id="@+id/dimTopRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dimSwitch"
                style="@style/SettingsColumnChoice"
                android:nextFocusDown="@id/dimValue" />

            <CheckBox
                android:id="@+id/dimKeep"
                style="@style/SettingsColumnChoice"
                android:layout_marginEnd="0dp"
                android:button="@drawable/random_box"
                android:nextFocusDown="@id/dimValue"
                android:text="@string/dim_keep" />
        </LinearLayout>

        <TextView
            android:id="@+id/dimValue"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:nextFocusUp="@id/dimSwitch" />

        <TextView
            android:id="@+id/dimStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="20dp"
            android:textColor="#FFFFFFFF"
            android:fontFamily="@string/font_regular"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/dim_hint"
            android:textColor="#FFACB8C1"
            android:fontFamily="@string/font_regular"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
